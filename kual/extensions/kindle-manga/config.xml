<?xml version="1.0" encoding="UTF-8"?>
<!--
  KUAL 扩展元信息。

  注意：<id> 必须和扩展目录名一致（extensions/kindle-manga/），否则 KUAL
  可能加载不到菜单。
-->
<extension>
  <information>
    <name>JMcomic for kindle</name>
    <version>1.2.0</version>
    <!-- & 必须写成 &amp;，否则 XML 非法，KUAL 会读不了这个扩展 -->
    <author>Zhriav-Wu&amp;Deepseek</author>
    <id>kindle-manga</id>
  </information>
  <menus>
    <menu type="json" dynamic="true">menu.json</menu>
  </menus>
</extension>
